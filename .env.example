# Supabase — obtén estos valores en supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Resend — envío de emails OTP desde nuestro dominio (obligatorio para el login con código)
# Obtén la API key en resend.com → API Keys
# EMAIL_FROM debe usar un dominio verificado en Resend (Resend → Domains)
RESEND_API_KEY=re_...
EMAIL_FROM=Focus <noreply@usefocus.me>

# ─── Hilante: OpenAI, configuración de servidor (2026-09-08) ─────────────
# Aplicar 020, 021 y 022 antes del backend. Sin admisión/ledger no hay llamada.
# Chat: OpenAI exclusivamente; la presencia de otras claves no cambia el router.
# Nunca usar VITE_OPENAI_API_KEY ni incluir secretos en iOS, frontend o git.
OPENAI_API_KEY=
# Se conserva únicamente para analizar fotos, no para conversaciones.
ANTHROPIC_API_KEY=
AI_PAID_CALLS_ENABLED=true
# false corta chat y fotos al cargar el entorno. Otros valores fallan cerrado.
# Corte inmediato sin redeploy: RPC service_role focus_ai_set_control(false).
# Estado: focus_ai_get_control(); reactivación: focus_ai_set_control(true).

# Tres modelos fijos: Luna/none, Terra/low y Sol/medium. Sin Astra, pro mode,
# ni selección automática de service tier. El usuario solo ve Hilante.
AI_NOVA_MAX_TIER=sol
AI_NOVA_LUNA_MAX_INPUT_TOKENS=12000
AI_NOVA_LUNA_MAX_OUTPUT_TOKENS=1600
AI_NOVA_TERRA_MAX_INPUT_TOKENS=18000
AI_NOVA_TERRA_MAX_OUTPUT_TOKENS=2400
AI_NOVA_SOL_MAX_INPUT_TOKENS=24000
AI_NOVA_SOL_MAX_OUTPUT_TOKENS=3200
# Entrada: techo conservador UTF-8 de instrucciones, schema, historial y mensaje.
# Salida incluye reasoning. Max 2 intentos por request, Sol como máximo una vez.
AI_MAX_COST_PER_REQUEST_USD=0.25
# Este techo permite recuperación Terra→Sol, siempre bajo reservas y cuotas.
# Nunca se reserva Sol para una petición simple. El fallback que no cabe se omite.
# Opcionales: límites globales adicionales que reducen los límites de cada tier.
# AI_MAX_TOKENS_PER_REQUEST=12000
# AI_MAX_OUTPUT_TOKENS=1600

# Presupuestos compartidos por chat y fotos; día UTC y ventana móvil de 30 días.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=20
AI_USER_DAILY_BUDGET_USD=0.25
AI_USER_MONTHLY_BUDGET_USD=5
AI_USER_REQUESTS_PER_MINUTE=5
AI_BUDGET_ALERT_PERCENTAGES=50,75,90
AI_ECONOMY_BUDGET_PERCENT=90
# Economía: Sol bloqueado, Luna prioritario, Terra solo con razón concreta.
# Al agotar presupuesto se bloquean nuevas llamadas pagadas. Lo manual funciona.
AI_SOL_ENABLED=true
AI_SOL_DAILY_BUDGET_USD=0.50
AI_SOL_MONTHLY_BUDGET_USD=3
AI_SOL_USER_DAILY_REQUESTS=2
AI_SOL_USER_MONTHLY_REQUESTS=10
AI_SOL_SHARE_ALERT_PERCENT=5
AI_SOL_SHARE_MIN_REQUESTS=20
# Una solicitud concurrente por usuario, lease de 55 s. El uso desconocido conserva
# reserva; se liquida cada intento y se guarda replay antes de responder.
# Un cero o importe inválido bloquea, nunca eleva el límite silenciosamente.
# Tarifas comprobadas el 8 de septiembre de 2026; Sol promocional: revisar antes del 20 de noviembre de 2026.

# Fotos: Anthropic Haiku, un intento, 4 imágenes/4 M caracteres base64, 2048 tokens de salida/25 s.
# Sin comparación equivalente no se afirma mejora al migrar imágenes a OpenAI.
# /api/transcribe pausado; iPhone usa dictado local y transcripción editable.
# Caché OpenAI explícita: solo prefijo de instrucciones estable, sin agenda.
# Replay: inaccesible tras 24 h; borrado físico en admisión/purge operativo.
# Guía actual y estados reales: docs/focus-2/AI_OPENAI_IMPLEMENTATION.md.

# Dólar CLP para el reporte de costos (scripts/ai-cost-report.mjs).
# Opcional: fija CLP_PER_USD con una cotización comprobada y su fecha.
# Sin ese valor, el reporte conserva USD y no inventa un cambio por defecto.
# CLP_PER_USD=

# API pública usada por la app iOS nativa para hablar con Vercel
VITE_API_ORIGIN=https://www.usefocus.me

# Web Push / cron
VITE_VAPID_PUBLIC_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@usefocus.me
CRON_SECRET=...

# APNs para app iOS nativa
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=me.usefocus.app
APNS_ENV=production
VITE_APNS_ENV=production
