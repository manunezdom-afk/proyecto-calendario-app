# Supabase — obtén estos valores en supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Resend — envío de emails OTP desde nuestro dominio (obligatorio para el login con código)
# Obtén la API key en resend.com → API Keys
# EMAIL_FROM debe usar un dominio verificado en Resend (Resend → Domains)
RESEND_API_KEY=re_...
EMAIL_FROM=Focus <noreply@usefocus.me>

# ─── Hilante: runtime del backend en esta rama (2026-09-08) ────────────────
# Configuración local preparada; no acredita cambios ya desplegados en Vercel.
# Aplicar/revisar supabase/migrations/021_ai_admission.sql antes de habilitar
# tráfico de IA: sin sus RPC de admisión/finish, no se llama al proveedor.
# Secretos SOLO en el servidor. No usar prefijos VITE_ ni incluir claves en git.
# No hay autodetección por presencia de claves ni aliases API_DE_DEEPSEEK,
# AI_PROVIDER_PRIMARY, AI_MODEL_CHEAP o AI_MODEL_MEDIUM en el runtime actual.
NOVA_PROVIDER=anthropic
AI_PAID_CALLS_ENABLED=true
# false detiene nuevas llamadas pagadas de chat Y fotos antes de admitirlas.
# Un valor explícito distinto de 'true' también bloquea; si falta, el runtime
# conserva true por compatibilidad. No usar otro alias para este interruptor.
ANTHROPIC_API_KEY=
# Alternativas opcionales; llenar solo la clave del proveedor autorizado.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Defaults por proveedor (sin override): Haiku 4.5 / GPT-5.6 Luna / DeepSeek V4 Flash.
# ANTHROPIC_NOVA_MODEL=claude-haiku-4-5-20251001
# OPENAI_NOVA_MODEL=gpt-5.6-luna
# DEEPSEEK_NOVA_MODEL=deepseek-v4-flash
# Un modelo distinto del económico exige habilitar premium y una tarifa vigente.
# La selección por defecto no afirma superioridad sobre proveedores no medidos.

# Ambos fallbacks son opt-in. Se reservan hasta dos intentos antes de llamar.
# Sin fallback opcional puede haber un reintento del mismo modelo; no asumir
# que cualquier error vuelve automáticamente al parser local del cliente.
AI_ENABLE_PROVIDER_FALLBACK=false
AI_ENABLE_PREMIUM_FALLBACK=false
# Premium: Sonnet 4.6 / GPT-5.6 Terra / DeepSeek V4 Pro, sujeto a cuotas y gasto.
# Un fallback que no cabe en el máximo por solicitud se omite; no bloquea el primario.
AI_MAX_OUTPUT_TOKENS=1600
AI_MAX_TOKENS_PER_REQUEST=12000
AI_MAX_COST_PER_REQUEST_USD=0.10
# Salida: 256..2048 tokens; entrada: 512..12000 (estimación conservadora con
# prompt, schema e historial). El máximo por solicitud nunca supera US$0.50.
# Las tarifas caducadas/desconocidas bloquean admisión; revisar aiPricing.js
# antes del 2026-12-01. Fuentes: docs/focus-2/AI_MODEL_RESEARCH.md.

# Presupuestos atómicos globales (todos los usuarios, USD) y por usuario.
# Estos son los defaults del runtime; puedes configurarlos más bajos.
# Un importe explícito cero, negativo o inválido bloquea; no restaura defaults.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=50
AI_USER_DAILY_BUDGET_USD=0.25
AI_USER_MONTHLY_BUDGET_USD=5
AI_USER_REQUESTS_PER_MINUTE=5
# Una solicitud concurrente por usuario; lease 55 segundos. Las cuotas del
# plan también se aplican. BETA_UNLIMITED_AI no elude la admisión monetaria.
# Las reservas evitan llamadas simultáneas sin cobertura; una llamada cuyo
# uso se desconoce conserva su reserva. No hay reintentos automáticos gratis.

# analyze-photo usa Anthropic Haiku, también con admisión global y del usuario:
# 4 imágenes, 4M caracteres base64 en total, 2048 tokens de salida, 25s, un intento.
# /api/transcribe está pausado hasta verificar duración/coste antes de reservar.
# iOS usa dictado en el dispositivo. Google/Gemini NO es un proveedor de producción;
# el adaptador de benchmark es independiente y no se activa con esta configuración.
# Los replays dejan de servirse a las 24h. El borrado físico se ejecuta al
# admitir solicitudes o mediante focus_ai_purge_replays(); programar la limpieza
# operativa antes de prometer una retención física máxima durante periodos sin tráfico.

# Dólar CLP para el reporte de costos (scripts/ai-cost-report.mjs).
# Opcional: fija CLP_PER_USD con una cotización comprobada y su fecha.
# Sin ese valor, el reporte conserva USD y no inventa un cambio por defecto.
# CLP_PER_USD=

# API pública usada por la app iOS nativa para hablar con Vercel
VITE_API_ORIGIN=https://www.usefocus.me

# Web Push / cron
VITE_VAPID_PUBLIC_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@usefocus.me
CRON_SECRET=...

# APNs para app iOS nativa
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=me.usefocus.app
APNS_ENV=production
VITE_APNS_ENV=production
