# Supabase — obtén estos valores en supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Resend — envío de emails OTP desde nuestro dominio (obligatorio para el login con código)
# Obtén la API key en resend.com → API Keys
# EMAIL_FROM debe usar un dominio verificado en Resend (Resend → Domains)
RESEND_API_KEY=re_...
EMAIL_FROM=Focus <noreply@usefocus.me>

# ─── IA de Nova (backend serverless — NO exponer NINGUNA en el cliente) ─────
# Proveedores. Con OPENAI_API_KEY presente, Nova usa OpenAI (router por tiers);
# ANTHROPIC_API_KEY queda como fallback si OpenAI falla (y para analyze-photo).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Forzar proveedor: 'openai' | 'anthropic' (default: auto → OpenAI si hay key)
# NOVA_PROVIDER=openai

# Router por tiers (defaults sensatos; solo tocar para experimentar):
# OPENAI_MODEL_NANO=gpt-5.4-nano     # tier barato — el grueso del tráfico
# OPENAI_MODEL_MINI=gpt-5.4-mini     # tier medio — mensajes complejos
# OPENAI_MODEL_HARD=gpt-5.5          # tier premium — solo fallback
# OPENAI_NOVA_MODEL=                 # kill-switch: fuerza UN modelo y apaga el router
# OPENAI_NOVA_MAX_OUTPUT_TOKENS=1024 # tope de salida si no lo fija el tier

# Premium fallback (gpt-5.5). APAGADO por defecto — encender solo cuando el
# costo esté medido. Cada uso consume cuota nova_premium_message del usuario.
AI_ENABLE_PREMIUM_FALLBACK=false

# Corta-circuito de presupuesto GLOBAL (suma de todos los usuarios, USD).
# Superado el tope, Nova responde 503 ai_budget_reached y el cliente degrada
# al parser local. Recomendado en beta: 1–2 diario, 20 mensual.
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=20

# Dólar CLP para el reporte de costos (scripts/ai-cost-report.mjs)
# CLP_PER_USD=940

# API pública usada por la app iOS nativa para hablar con Vercel
VITE_API_ORIGIN=https://www.usefocus.me

# Web Push / cron
VITE_VAPID_PUBLIC_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@usefocus.me
CRON_SECRET=...

# APNs para app iOS nativa
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=me.usefocus.app
APNS_ENV=production
VITE_APNS_ENV=production
