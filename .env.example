# Supabase — obtén estos valores en supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Resend — envío de emails OTP desde nuestro dominio (obligatorio para el login con código)
# Obtén la API key en resend.com → API Keys
# EMAIL_FROM debe usar un dominio verificado en Resend (Resend → Domains)
RESEND_API_KEY=re_...
EMAIL_FROM=Focus <noreply@usefocus.me>

# ─── IA de Nova (backend serverless — NO exponer NINGUNA en el cliente) ─────
# Proveedor PRINCIPAL: DeepSeek (el más barato, ~$0.0005-0.001/mensaje).
# Autodetección: DEEPSEEK_API_KEY > OPENAI_API_KEY > ANTHROPIC_API_KEY.
# La key se pega SOLO en Vercel (o .env local), jamás en el código.
DEEPSEEK_API_KEY=sk-...
# Forzar proveedor: 'deepseek' | 'openai' | 'anthropic'. Alias: AI_PROVIDER_PRIMARY.
NOVA_PROVIDER=deepseek

# Router DeepSeek (defaults correctos; solo tocar para experimentar):
# DEEPSEEK_MODEL_CHEAP=deepseek-v4-flash  # simple Y normal (el grueso) — alias AI_MODEL_CHEAP
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro      # complejo/clarificaciones — alias AI_MODEL_MEDIUM
# DEEPSEEK_NOVA_MODEL=                    # kill-switch: fuerza UN modelo, apaga router
# AI_MAX_OUTPUT_TOKENS=900                # tope de salida por request (todos los tiers)
# AI_MAX_TOKENS_PER_REQUEST=12000         # tope de input; sobre esto se recorta historial

# Fallback a OTROS proveedores pagos si DeepSeek falla. APAGADO por defecto:
# sin esto, un fallo de DeepSeek degrada al parser local (gratis), NUNCA a
# GPT/Claude sin permiso. Encender solo si quieres esa red de seguridad paga.
AI_ENABLE_PROVIDER_FALLBACK=false

# Proveedores secundarios (opcionales si NOVA_PROVIDER=deepseek):
# ANTHROPIC_API_KEY sigue siendo necesaria para analyze-photo (visión).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# Router OpenAI (solo si NOVA_PROVIDER=openai o fallback activo):
# OPENAI_MODEL_NANO=gpt-5.4-nano / OPENAI_MODEL_MINI=gpt-5.4-mini / OPENAI_MODEL_HARD=gpt-5.5
# OPENAI_NOVA_MODEL= (kill-switch) / OPENAI_NOVA_MAX_OUTPUT_TOKENS=1024

# Premium fallback (gpt-5.5). APAGADO por defecto — encender solo cuando el
# costo esté medido. Cada uso consume cuota nova_premium_message del usuario.
AI_ENABLE_PREMIUM_FALLBACK=false

# Corta-circuito de presupuesto GLOBAL (suma de todos los usuarios, USD).
# Superado el tope, Nova responde 503 ai_budget_reached y el cliente degrada
# al parser local. Con carga de ~US$5: 0.50 diario / 5 mensual.
AI_DAILY_BUDGET_USD=0.50
AI_MONTHLY_BUDGET_USD=5

# Dólar CLP para el reporte de costos (scripts/ai-cost-report.mjs)
# CLP_PER_USD=940

# API pública usada por la app iOS nativa para hablar con Vercel
VITE_API_ORIGIN=https://www.usefocus.me

# Web Push / cron
VITE_VAPID_PUBLIC_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=mailto:admin@usefocus.me
CRON_SECRET=...

# APNs para app iOS nativa
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=me.usefocus.app
APNS_ENV=production
VITE_APNS_ENV=production
