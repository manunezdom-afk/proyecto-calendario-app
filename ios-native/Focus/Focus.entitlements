<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push remotas (APNs). "development" para builds Debug/TestFlight
	     local; al archivar para App Store, el perfil de distribución lo
	     re-firma como "production" automáticamente (signing automático).
	     El backend acepta ambos ambientes (api/push native_subscribe →
	     body.environment). -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- App Group compartido con FocusWidgetExtension: la app escribe el
	     snapshot de eventos del día y el widget lo lee. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.me.usefocus.app</string>
	</array>
</dict>
</plist>
